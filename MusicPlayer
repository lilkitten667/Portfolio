        music = "/Users/bespectacled-brainy-tech-kitten/Music/music"
        dir = "music"
        music = os.path.join(path, dir, music)
        print("Your new bopping tunes directory is: " + music)
        
        os.chdir(music)

        # Inserting songs into playlist
        self.refresh()

    def search(self):
        """
        TODO: Explain below in this docstring what an algorithm is.
