        This algorithm retrieves the playlist, then empties it in
        readiness for the search function. I then set query to the 
        inputVar, and I shrunk the alpha characters, and took away all
        of the un-wanted white spaces. Finally in the the "Try/For" loop I
        said for every variable *set to filename* in templist. we asked the 
        app to check for every query in every filename to shrink all a. char. and place
        them all in the self.playlist using the insert function staring at the end 
        we are going insert the variable filename. and we are going to catch all exceptions
        as err and set them to the players status. 



        DONE: Remove from the self.playlist ListBox any filename that does not
        partially match the characters from the self.inputVar of the
        search_input Entry widget. Catch any possible exceptions.
        """
        templist = self.playlist.get(0, END)
        self.playlist.delete(0, END)
        query = self.inputVar.get().casefold().strip()
         
        try:
            for filename in templist:
                if query in filename.casefold():
                    self.playlist.insert(END, filename)
        except Exception as err:
            self.status.set(err)
        
        
    def playsong(self):
        """
        DONE:
        Displays selected song and its playing status and plays the song.
        """
        songs = self.playlist.get(ACTIVE)
        self.status.set("-Playing")
        self.track.set(songs)
        pygame.mixer.music.load(songs)
        pygame.mixer.music.play()

    def stopsong(self):
        """DONE: Displays stopped status and stops the song."""
        self.status.set("-Stopped")
        pygame.mixer.music.stop()

    def pausesong(self):
        """DONE: Displays the paused status and pauses the song."""
        self.status.set("Paused")
        pygame.mixer.music.pause()

    def unpausesong(self):
        """DONE: Displays the playing status and unpauses the song."""
        self.status.set("-Playing")
        pygame.mixer.music.unpause()

    def refresh(self):
        """
        DONE:
        Clears the current playlist and fills it with all valid sound files
        from the music folder. All exception messages are appended to the
        status in their default string form.
        See the .pdf reference files for how to insert items into a tkinter
        Listbox.
        """
        # DONE: First clear the search_input Entry widget via self.inputVar
        self.playlist.delete(0, 'end')

        # DONE: Ignore files whose names that start with "."
        # and those that are not .mp3, .ogg, or .wav files
        file_type = ('.mp3', '.ogg', '.wav')

        sound_track = os.listdir()

        try:
            for filename in sound_track:
                if filename[0] != ".":
                    if filename.endswith(file_type):
                        self.playlist.insert('end', filename)
        except Exception as err:
            self.status.set("Error" + str(err))
        print(self.playlist)

